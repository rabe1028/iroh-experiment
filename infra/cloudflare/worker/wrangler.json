{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "iroh-h3-observer",
  "main": "src/index.js",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SIGNAL_ROOMS",
        "class_name": "SignalingRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-signaling",
      "new_sqlite_classes": [
        "SignalingRoom"
      ]
    }
  ]
}
